st/demom/work/README.md","D:/space/aiteam/test/demom/work/corpus.md","D:/space/aiteam/test/demom/corpus.md"],"usage":{"input":8735,"output":6071,"cacheRead":20224,"cacheWrite":0,"totalTokens":35030,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}}}],"agentCount":5,"toolCalls":98,"inTokens":43015,"outTokens":25583,"totalTokens":161270,"costUsd":0,"maxDepth":1,"delegations":0,"budgetHit":false,"verdict":{"ok":false,"covered":true,"idsValid":true,"deduped":true,"contradictionPaired":true,"distractorClean":false,"dedupDetail":[{"group":["M3","M7"],"ok":true},{"group":["M12","M31"],"ok":true},{"group":["M13","M24","M34"],"ok":true},{"group":["M2","M19"],"ok":true},{"group":["M18","M37"],"ok":true}],"contradictionDetail":[{"group":["M5","M9"],"ok":true},{"group":["M16","M28"],"ok":true},{"group":["M27","M39"],"ok":true},{"group":["M6","M33"],"ok":true}],"failed":["把无关材料当了依据（越界）：M11、M21、M41"],"reportHash":"bc86902a","reportChars":1186},"reportText":"# 报告：T1–T5 主题汇总\n\n> 本报告基于 draft/S1-摸底.md、draft/S2-去重.md、draft/S3-查矛盾.md 整理。原文语料（M1–M41）在磁盘上未能定位，具体内容以上游阶段摘要为准；仅使用上游材料中引用过的编号，未自造编号。重复材料已按 S2 去重结果合并（同组材料只出现在同一条 bullet 中），矛盾结论成对写明。\n\n## T1 上下文管理：裁剪、压缩与占用视角\n\n- 逐轮裁剪只影响当前这一轮、比压缩更划算——压缩牵动整段历史，裁剪是更便宜的成本取舍。（M1、M7）\n- 读上下文占用有两个视角：context.usage 看占用量，history/messages 看已发送的内容但不含 system。（M2、M19）\n\n依据：M1、M2、M7、M19\n\n## T2 门（gate）：单槽位与判定逻辑\n\n- 门是单槽位、写后没有读回来的机会，判定逻辑必须一次写清；M38 补充了纯函数写法来保证这一点。（M8、M20、M38）\n- 门的拦截严格度存在分歧：M16 主张门应该拦得尽可能严；M28 认为门拦得太严会误事。（M16、M28）\n\n依据：M8、M16、M20、M28、M38\n\n## T3 白名单：硬过滤、宽度之争与边界\n\n- 白名单是硬过滤：名单外的工具压根不可见，不是「知道但被拦」。（M18、M37）\n- 白名单是裁剪不是沙箱：名单改的是工具集，门拦的是某一次调用，两件事不同。（M17、M35）\n- 白名单宽度对任务完成率的影响结论相反：白名单从 3 个工具扩到 6 个，M5 说任务完成率从 40% 提到 90%（越宽越好），M9 说从 80% 掉到 55%（越宽越差）。（M5、M9）\n- 环境扩展是否并入白名单存在分歧：M6 说环境扩展不并入白名单；M33 实测发现环境扩展其实会并入白名单。（M6、M33）\n\n依据：M5、M6、M9、M17、M18、M33、M35、M37\n\n## T4 递归与深度护栏\n\n- 库不提供 maxDepth，递归深度只能自己数；子 agent 也会拿到派活工具，需要计数器兜底。（M13、M24、M34）\n\n依据：M13、M24、M34\n\n## T5 行为约束：花名册与技能\n\n- 花名册/成员表能约束行为：给名单就只能从中挑人，不给则可以任意起人。（M12、M31）\n- 技能作为约束手段的有效性存在分歧：M27 认为技能是可靠的约束手段；M39 认为技能基本不起作用。（M27、M39）\n\n依据：M12、M27、M31、M39\n\n## 附：与 T1–T5 无关的材料\n\n- M11（本季度食堂菜单与轮值安排）、M21（办公楼消防演练通知）、M41（打印机耗材领用流程的更新）与五个主题均无关，不参与上述各节。（M11、M21、M41）\n\n依据：M11、M21、M41\n"}
