{
  "name": "hunt-viz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "hunt 集群的研究数据可视化（离线单页，加载 vizdata.ts 导出的 JSON）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}