{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "dev/test",
    "dev/demo",
    "research/clusters",
    "research/demox",
    "dev/examples"
  ],
  "exclude": [
    "research/demox/lab-brief*/**",
    "research/demox/lab-*/**",
    "research/demox/lab-3*/**",
    "node_modules",
    "dev/pi",
    "dev/demo/run",
    "dev/demo/work",
    "dev/spike",
    "research/demox/lab-1/work",
    "research/demox/work",
    "dev/test/_sbx*",
    "research/clusters/*/micro/_sandbox*"
  ]
}
